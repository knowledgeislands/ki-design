{
  "name": "@knowledgeislands/design",
  "description": "The machine-readable Knowledge Islands design system: tokens, icons, symbol library, tile sets, hex map engine and web components that every surface renders with.",
  "version": "0.2.0",
  "author": "kris@kris.me.uk",
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "rumdl": "^0.3.0",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/knowledgeislands/ki-design#readme",
  "keywords": [
    "design-system",
    "design-tokens",
    "hex-map",
    "isometric",
    "knowledge-islands",
    "web-components"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "bunx @biomejs/biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "bunx rumdl check --fix"
    ]
  },
  "packageManager": "bun@1.4.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowledgeislands/ki-design.git"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "ki:deps:update": "bun update --latest",
    "prepare": "git config core.hooksPath .githooks && bun install --frozen-lockfile --cwd tooling/depcruise",
    "self:boards": "bun docs/design-review/generators/build-boards.ts",
    "self:preview": "bun examples/observatory-preview/server.ts",
    "self:typecheck": "turbo run typecheck",
    "test": "turbo run test && bun test examples/observatory-preview docs/design-review/generators"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ]
}
