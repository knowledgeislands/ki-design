{
  "name": "packages-tessera",
  "description": "Tessera, the Knowledge Islands design system: tokens, glyphs, the symbol library, tile sets, the hex map engine and web components, each a package a site copies and locks on its own.",
  "version": "0.2.0",
  "author": "kris@kris.me.uk",
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "rumdl": "^0.3.0",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/knowledgeislands/packages-tessera#readme",
  "keywords": [
    "design-system",
    "design-tokens",
    "hex-map",
    "isometric",
    "knowledge-islands",
    "web-components"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --no-errors-on-unmatched"
    ],
    "*.md": [
      "rumdl check"
    ]
  },
  "packageManager": "bun@1.4.3",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowledgeislands/packages-tessera.git"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "ki:deps:update": "bun update --latest",
    "prepare": "git config core.hooksPath .githooks && bun install --frozen-lockfile --cwd tooling/depcruise",
    "self:boards": "bun docs/design-review/generators/build-boards.ts",
    "self:lint": "biome check .",
    "self:manifest": "bun scripts/manifest.ts",
    "self:storybook": "bun run --cwd apps/storybook dev",
    "self:storybook:build": "turbo run build --filter=tessera-storybook",
    "self:typecheck": "turbo run typecheck",
    "test": "turbo run test && bun test docs/design-review/generators && bun scripts/manifest.ts --check"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
