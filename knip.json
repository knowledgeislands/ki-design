{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".claude/skills/**", ".agents/skills/**"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["*.ts", "scripts/**/*.ts", "docs/design-review/generators/*.ts"],
      "project": ["*.ts", "scripts/**/*.ts", "docs/design-review/generators/*.ts"],
      "husky": { "config": [".githooks/pre-commit", ".githooks/commit-msg"] }
    },
    "packages/*": { "entry": ["src/index.ts", "src/**/*.test.ts"], "project": ["src/**/*.ts"] }
  }
}
