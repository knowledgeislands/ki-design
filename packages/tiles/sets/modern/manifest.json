{
  "schema": "tileset/v1",
  "id": "modern",
  "name": "Modern",
  "description": "Clean, engraved tiles: deep-ink linework over flat token fills, light from the top-left. The default set for the apps, docs, diagrams and print.",
  "licence": "UNLICENSED",
  "art": {
    "version": "0.1.0",
    "generator": "packages/tiles/scripts/generate-modern.ts",
    "format": "svg",
    "anchorNote": "`anchor` is in cell pixels (the 256 × 196 cell of the anchor hex); `art.anchor` is the same point in the canvas pixels of the SVG, whose view box extends above (and, for pair and flower footprints, beside) the cell.",
    "themeNote": "Fills are CSS custom properties with token fallbacks: --terrain-<name>, --tile-water (the ocean and coastal water, from color.tile.water), --tile-ink, --tile-paper, --tile-plinth, --tile-deep, --tile-pine, --tile-leaf, --bld-limestone, --bld-slate, --bld-timber, --bld-brick, --bld-thatch, --bld-brass, --bld-stone.",
    "aliasesNote": "`aliases` maps deprecated tile keys to their replacements (`structure/citadel` is `structure/capital`, `structure/bridge` is `structure/causeway`); renderers resolve them so older maps keep working.",
    "framesNote": "v0 draws frame 0 (the still) only; animated loops are declared in `frames` and not yet drawn."
  },
  "aliases": {
    "structure/citadel": "structure/capital",
    "structure/bridge": "structure/causeway"
  },
  "conditions": {
    "note": "Every structure is drawn once (thriving). The other states are compositions of that drawing and the decals, under the same light.",
    "thriving": {
      "hide": [],
      "decals": []
    },
    "quiet": {
      "hide": ["[data-state=\"thriving\"]"],
      "decals": []
    },
    "weathered": {
      "hide": ["[data-state=\"thriving\"]"],
      "decals": ["moss", "cracks"]
    },
    "ruined": {
      "hide": ["[data-state=\"thriving\"]"],
      "decals": ["ivy", "moss", "cracks", "fallen-roof"]
    }
  },
