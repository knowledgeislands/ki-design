{
  "$description": "Knowledge Islands design tokens (DTCG format). Values are authoritative here; meaning is canon in ki-principal.",
  "color": {
    "$type": "color",
    "core": {
      "navy": { "$value": "#0f2440", "$description": "Deep sea; night paper." },
      "ocean": { "$value": "#1b3a5c", "$description": "Open water; the light accent." },
      "teal": { "$value": "#317070", "$description": "Shallows and currents." },
      "forest": { "$value": "#2d5a3d", "$description": "Old growth; the light ok role." },
      "moss": { "$value": "#4a7a5a", "$description": "Young growth and soft greens." },
      "sandstone": { "$value": "#c4a882", "$description": "Built stone and shoreline." },
      "parchment": { "$value": "#f5efe0", "$description": "The chart paper; light paper." },
      "gold": { "$value": "#c8963c", "$description": "Lantern light; decorative gold, the night warn role." },
      "text-gold": { "$value": "#8a5a12", "$description": "Gold dark enough to read as text; the light warn role." },
      "rust": { "$value": "#9b2c1c", "$description": "Iron oxide; the light bad role." },
      "mist": { "$value": "#eef1f5", "$description": "Sea mist; cool neutral surface." },
      "ink": { "$value": "#1a2030", "$description": "Body text on parchment." },
      "ink-light": { "$value": "#4a5568", "$description": "Secondary text on parchment." },
      "border": { "$value": "#d4c9b4", "$description": "Hairline rule on parchment." },
      "border-light": { "$value": "#e8e0d0", "$description": "Faint divider on parchment." }
    },
    "role": {
      "light": {
        "paper": { "$value": "#f5efe0", "$description": "Page background (parchment)." },
        "ink": { "$value": "#1a2030", "$description": "Body text." },
        "muted": { "$value": "#4a5568", "$description": "Secondary text." },
        "accent": { "$value": "#1b3a5c", "$description": "Links and primary actions (ocean)." },
        "ok": { "$value": "#2d5a3d", "$description": "Healthy state (forest)." },
        "teal": { "$value": "#317070", "$description": "Informational highlight." },
        "warn": { "$value": "#8a5a12", "$description": "Attention state (text gold)." },
        "bad": { "$value": "#9b2c1c", "$description": "Blocking or failed state (rust)." },
        "rule": { "$value": "#d4c9b4", "$description": "Decorative hairline; not a control boundary." },
        "boundary": { "$value": "#9a8358", "$description": "Control boundary; must hold 3:1 on paper." }
      },
      "night": {
        "paper": { "$value": "#0f2440", "$description": "Page background (navy)." },
        "ink": { "$value": "#f5efe0", "$description": "Body text." },
        "muted": { "$value": "#a9b4c4", "$description": "Secondary text." },
        "accent": { "$value": "#9fbbd8", "$description": "Links and primary actions." },
        "ok": { "$value": "#8fc4a0", "$description": "Healthy state." },
        "teal": { "$value": "#7fc2c0", "$description": "Informational highlight." },
        "warn": { "$value": "#c8963c", "$description": "Attention state (gold)." },
        "bad": { "$value": "#f0947a", "$description": "Blocking or failed state." },
        "rule": { "$value": "#24476e", "$description": "Decorative hairline; not a control boundary." },
        "boundary": { "$value": "#5f7896", "$description": "Control boundary; must hold 3:1 on paper." }
      }
    },
    "wash": {
      "light": {
        "ok": { "$value": "#ddddcc", "$description": "Forest 12 % into paper." },
        "warn": { "$value": "#f1e8d3", "$description": "Gold 8 % into paper." },
        "bad": { "$value": "#ead8c8", "$description": "Rust 12 % into paper." }
      },
      "night": {
        "ok": {
          "$value": "#1e374c",
          "$description": "Night ok 12 % into night paper (derived by the same rule as light)."
        },
        "warn": {
          "$value": "#1e2d40",
          "$description": "Gold 8 % into night paper (derived by the same rule as light)."
        },
        "bad": {
          "$value": "#2a3147",
          "$description": "Night bad 12 % into night paper (derived by the same rule as light)."
        }
      }
    },
    "terrain": {
      "grassland": { "$value": "#a9b97c", "$description": "Open meadow." },
      "forest": { "$value": "#4f7a57", "$description": "Woodland canopy." },
      "hills": { "$value": "#b9a56f", "$description": "Rolling uplands." },
      "mountain": { "$value": "#8c8577", "$description": "Bare rock heights." },
      "coastal": { "$value": "#cfc79a", "$description": "Dune grass and shore turf." },
      "cliffs": { "$value": "#a2927c", "$description": "Sea-cut stone faces." },
      "sand": { "$value": "#e4d4a6", "$description": "Beaches and spits." },
      "river": { "$value": "#6f9db5", "$description": "Running fresh water." },
      "marsh": { "$value": "#7f9070", "$description": "Reed beds and wetland." },
      "snow": { "$value": "#eef1f5", "$description": "Snowfields and peaks (mist)." },
      "volcanic": { "$value": "#5b4743", "$description": "Basalt and ash." },
      "ocean": { "$value": "#2f5878", "$description": "Open sea around the islands." }
    },
    "sea": {
      "light": {
        "deep": { "$value": "#b9cfd2", "$description": "Open ocean far from land." },
        "sea": { "$value": "#d6e3e1", "$description": "Default water on the printed chart." },
        "shallow": { "$value": "#e4ece4", "$description": "Water within one hex of land." },
        "current": { "$value": "#317070", "$description": "Current lines." },
        "lane": { "$value": "#8a5a12", "$description": "Trade-route lanes." }
      },
      "night": {
        "deep": { "$value": "#0b1b31", "$description": "Open ocean far from land." },
        "sea": { "$value": "#0f2440", "$description": "Default water by lantern-light (the night paper)." },
        "shallow": { "$value": "#17345a", "$description": "Water within one hex of land." },
        "current": { "$value": "#7fc2c0", "$description": "Current lines." },
        "lane": { "$value": "#c8963c", "$description": "Trade-route lanes." }
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "site": {
      "display": { "$value": ["Cormorant Garamond", "Georgia", "serif"], "$description": "Site headings." },
      "smallcaps": {
        "$value": ["Cormorant SC", "Cormorant Garamond", "Georgia", "serif"],
        "$description": "Site labels and small capitals."
      },
      "body": { "$value": ["Inter", "system-ui", "sans-serif"], "$description": "Site body text." }
    },
    "app": {
      "sans": {
        "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
        "$description": "App interface text."
      },
      "serif": {
        "$value": ["ui-serif", "Georgia", "Cambria", "Times New Roman", "serif"],
        "$description": "App reading text."
      }
    },
    "mono": {
      "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "Liberation Mono", "monospace"],
      "$description": "Code and data."
    }
  },
  "space": {
    "$type": "dimension",
    "2": { "$value": "2px" },
    "4": { "$value": "4px" },
    "8": { "$value": "8px" },
    "12": { "$value": "12px" },
    "16": { "$value": "16px" },
    "24": { "$value": "24px" },
    "32": { "$value": "32px" },
    "48": { "$value": "48px" },
    "64": { "$value": "64px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "16px" }
  },
  "motion": {
    "$type": "number",
    "fps": { "$value": 12, "$description": "The animation clock: frames per second." },
    "cycle": {
      "$value": 48,
      "$description": "Master cycle in frames; frame 0 is the still image.",
      "$extensions": { "uk.knowledgeislands.loops": [4, 6, 8, 12, 16, 24, 48] }
    }
  }
}
